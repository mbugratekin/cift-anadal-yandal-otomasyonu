@model CapYandal.Web.Models.DersIlerlemeModeli
@using System.Globalization
@functions { string Deger(decimal? value) => value?.ToString("0.##", CultureInfo.GetCultureInfo("tr-TR")) ?? "Belirsiz"; }
<section class="course-progress" aria-label="Kişisel ders listelerinin tamamlanma özeti">
    <h2>Ders Takibi</h2>
    <div class="profile-table-scroll course-list-scroll"><table class="program-information">
        <caption class="visually-hidden">Onaylı kişisel ders listelerinde tamamlanan ve kalan dersler</caption>
        <thead><tr><th scope="col">Ders kodu</th><th scope="col">Ders adı</th><th scope="col">Durum</th><th scope="col">Kredi</th><th scope="col">AKTS</th></tr></thead>
        <tbody>@foreach(var row in Model.Dersler) { <tr><td>@row.Kod</td><td>@row.Ad @if(row.KopyaCeliskisi) { <small>Kayıt kopyaları farklı</small> }</td><td>@(row.Tamamlandi ? "Tamamlandı" : "Henüz tamamlanmadı")</td><td>@Deger(row.Kredi)</td><td>@Deger(row.Akts)</td></tr> }</tbody>
        <tfoot>
            <tr><th colspan="3" scope="row">Tamamlanan (@Model.TamamlananSayisi ders)</th><td>@Deger(Model.TamamlananKredi)</td><td>@Deger(Model.TamamlananAkts)</td></tr>
            <tr><th colspan="3" scope="row">Henüz tamamlanmayan (@Model.KalanSayisi ders)</th><td>@Deger(Model.KalanKredi)</td><td>@Deger(Model.KalanAkts)</td></tr>
        </tfoot>
    </table></div>
    @if (Model.BekleyenListeSayisi > 0) { <p>Onay bekleyen @Model.BekleyenListeSayisi liste var. Bu listelerdeki yeni dersler kesin toplamlara alınmadı.</p> }
    @if (Model.Dersler.Any(x => x.KopyaCeliskisi)) { <p>Farklı kayıt kopyaları bulunan dersleri koordinatör incelemelidir. Çelişkili kredi/AKTS için tahmini toplam verilmez.</p> }
</section>
